{
  "name": "@rome/app-diffview",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rome dev",
    "build": "rome build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/*.test.ts",
    "test:worker": "pnpm build && node --test tests/worker-bundle.browser.mjs",
    "test:menu": "pnpm build && node --test tests/menu.browser.mjs",
    "test:scroll": "pnpm build && node --test tests/scroll.browser.mjs",
    "test:browser": "pnpm build && node --test --test-concurrency=1 tests/worker-bundle.browser.mjs tests/scroll.browser.mjs tests/menu.browser.mjs tests/git-output.browser.mjs tests/refresh-paging.browser.mjs tests/path-safety.browser.mjs",
    "test:agent-browser": "pnpm build && node --test tests/agent-surfaces.browser.mjs"
  },
  "dependencies": {
    "@pierre/diffs": "1.6.1",
    "@rome-os/app-runtime": "^0.11.3",
    "@rome-os/app-web-sdk": "^0.4.0",
    "@rome-os/ui": "^0.3.6",
    "@tanstack/react-query": "^5.62.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "better-sqlite3": "^12.9.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
